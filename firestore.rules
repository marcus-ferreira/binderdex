rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidBinder(data) {
      return data.keys().hasAll(['id', 'title', 'totalPages', 'cards', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['id', 'title', 'game', 'coverImageUrl', 'ringColor', 'totalPages', 'cards', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.totalPages is number &&
             data.cards is map &&
             data.createdAt is number &&
             data.updatedAt is number;
    }

    match /users/{userId}/binders/{binderId} {
      allow list, get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(binderId) && isValidBinder(request.resource.data) && request.resource.data.id == binderId;
      allow update: if isOwner(userId) && isValidId(binderId) && isValidBinder(request.resource.data) && request.resource.data.id == binderId && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId) && isValidId(binderId);
    }
  }
}
